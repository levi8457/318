# 生产环境配置

# 应用
APP_PORT=3000
APP_ENV=production

# 数据库（生产环境请修改为强密码）
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=tongquetai
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DB_DATABASE=tongquetai

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# JWT（生产环境请修改为随机密钥）
JWT_SECRET=CHANGE_ME_RANDOM_SECRET_KEY_AT_LEAST_32_CHARS
JWT_EXPIRES_IN=7d

# 默认管理员（首次启动后请立即修改密码）
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD

# AI/LLM
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 数据加密密钥（32位随机字符串）
ENCRYPTION_KEY=CHANGE_ME_32_CHARS_ENCRYPTION_KEY

# 文件存储
UPLOAD_DIR=/app/uploads
MAX_FILE_SIZE=50mb
