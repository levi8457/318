{
  "name": "tongquetai-ai-agent",
  "version": "1.0.0",
  "private": true,
  "description": "铜雀台医美 AI 智能管家",
  "scripts": {
    "dev": "pnpm --filter @tongquetai/shared build && concurrently \"pnpm --filter @tongquetai/server start:dev\" \"pnpm --filter @tongquetai/web dev\"",
    "dev:web": "pnpm --filter @tongquetai/web dev",
    "dev:server": "pnpm --filter @tongquetai/shared build && pnpm --filter @tongquetai/server start:dev",
    "build": "pnpm --filter @tongquetai/shared build && pnpm --filter @tongquetai/server build && pnpm --filter @tongquetai/web build",
    "type-check": "pnpm -r type-check",
    "lint": "eslint 'apps/*/src/**/*.{ts,tsx,vue}' 'packages/*/src/**/*.ts'",
    "lint:fix": "eslint --fix 'apps/*/src/**/*.{ts,tsx,vue}' 'packages/*/src/**/*.ts'",
    "test": "pnpm -r test",
    "migration:run": "pnpm --filter @tongquetai/server migration:run",
    "migration:generate": "pnpm --filter @tongquetai/server migration:generate",
    "migration:revert": "pnpm --filter @tongquetai/server migration:revert"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "concurrently": "^8.2.0",
    "eslint": "^8.57.0",
    "eslint-plugin-vue": "^9.20.0",
    "prettier": "^3.2.0",
    "typescript": "^5.4.0"
  }
}
